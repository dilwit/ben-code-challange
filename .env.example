# Copy to .env.local (never committed). Read only on the server.

# Commission Quote API (the bundled mock serves it under /commission-quote-api)
COMMISSION_QUOTE_API_BASE_URL=http://localhost:4010/commission-quote-api
COMMISSION_QUOTE_API_KEY=local-dev-key
# Optional. Whole number from 1 to 9000 (must stay under the browser's 10 s timeout).
COMMISSION_QUOTE_API_TIMEOUT_MS=5000
